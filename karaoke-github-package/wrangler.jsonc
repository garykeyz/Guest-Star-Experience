{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gueststarexperience",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "KARAOKE_APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbxpUugPQJ1N3yb8uezB6fpd84CELAKtbuB2maE3HberOBGo5ObABGtN3ZfCI3UvKbLkzg/exec"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  }
}
