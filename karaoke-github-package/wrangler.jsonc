{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gueststarexperience",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GOOGLE_OAUTH_CLIENT_ID": "880632654473-msu6iflunmvn4916obdl5cp39orj2lrk.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "GUEST_STAR_DB",
      "database_name": "guest-star-experience",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  }
}
