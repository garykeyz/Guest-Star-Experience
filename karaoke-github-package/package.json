{
  "name": "guest-star-karaoke",
  "version": "4.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test:http": "node scripts/production-http-test.mjs",
    "test:d1": "esbuild scripts/d1-backend-test.ts --bundle --platform=node --format=esm --packages=external --alias:@opennextjs/cloudflare=./scripts/cloudflare-test-stub.ts --outfile=/tmp/guest-star-d1-test.mjs && node /tmp/guest-star-d1-test.mjs",
    "test:d1:http": "opennextjs-cloudflare build && node scripts/local-d1-http-load-test.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply guest-star-experience --local",
    "d1:migrate:remote": "wrangler d1 migrations apply guest-star-experience --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "wrangler": "4.154.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "7.30.1",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^5.0.0": "5.0.12",
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
