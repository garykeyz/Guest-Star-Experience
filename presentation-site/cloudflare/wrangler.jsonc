{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gstarxp-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "gstarxp.com",
      "custom_domain": true
    }
  ]
}
